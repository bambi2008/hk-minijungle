# Copy into the deployment secret manager. Do not commit real values.
DR_FOREST_ENV=production
HOST=0.0.0.0
PORT=8010

# Persistence
DR_FOREST_STORAGE_BACKEND=postgres
DR_FOREST_DATABASE_URL=postgresql://ops_app:REPLACE@private-db.example.com:5432/dr_forest_ops?sslmode=require
DR_FOREST_DB_POOL_MAX=20

# Proof/camera media and encrypted backup
DR_FOREST_PROOF_MEDIA_BACKEND=s3
DR_FOREST_OBJECT_STORAGE_ENDPOINT=https://s3.example.com
DR_FOREST_OBJECT_STORAGE_REGION=ap-east-1
DR_FOREST_OBJECT_STORAGE_BUCKET=dr-forest-ops-prod
DR_FOREST_OBJECT_STORAGE_ACCESS_KEY=REPLACE
DR_FOREST_OBJECT_STORAGE_SECRET_KEY=REPLACE
DR_FOREST_BACKUP_DESTINATION=s3://dr-forest-ops-backups/hk/prod
DR_FOREST_BACKUP_ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_OR_MORE

# Enterprise identity. JWT role/client claims are configurable in ops-auth.mjs.
DR_FOREST_IDP_ISSUER=https://login.example.com/tenant/v2.0
DR_FOREST_IDP_JWKS_URL=https://login.example.com/tenant/discovery/v2.0/keys
DR_FOREST_IDP_AUDIENCE=api://dr-forest-ops
DR_FOREST_IDP_ROLE_CLAIM=role
DR_FOREST_IDP_CLIENT_IDS_CLAIM=client_ids
DR_FOREST_DEFAULT_TENANT=dr-forest-hk
DR_FOREST_ALLOWED_ORIGINS=https://ops.example.com,https://field.example.com
DR_FOREST_PRODUCTION_BASE_URL=https://ops.example.com

# Device security
DR_FOREST_DEVICE_REPLAY_WINDOW_SECONDS=300
DR_FOREST_DEVICE_SIGNING_SECRET=REPLACE_WITH_32_BYTES_OR_MORE
DR_FOREST_EVIDENCE_SIGNING_SECRET=REPLACE_WITH_32_BYTES_OR_MORE
DR_FOREST_EVIDENCE_SIGNING_KEY_ID=dr-forest-evidence-hmac-v1
DR_FOREST_EVIDENCE_RETENTION_DAYS=365
DR_FOREST_TRUST_PROXY=true

# Observability. The application emits structured JSON to stdout; connect the
# deployment log sink and alert route through the hosting platform.
DR_FOREST_LOG_SINK=stdout
DR_FOREST_ALERT_WEBHOOK_URL=https://monitoring.example.com/hooks/dr-forest
DR_FOREST_ALERT_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
DR_FOREST_NOTIFICATION_MAX_ATTEMPTS=8
DR_FOREST_DEVICE_MAX_READING_BATCH=100
DR_FOREST_DEVICE_INGESTION_IP_LIMIT=1200
DR_FOREST_DEVICE_INGESTION_DEVICE_LIMIT=300
DR_FOREST_DEVICE_INGESTION_GATEWAY_LIMIT=1200

# These markers are set only by the release operator after real evidence is attached.
DR_FOREST_FULL_POSTGRES_MIGRATION=pending
DR_FOREST_OFFHOST_RESTORE_DRILL=pending
DR_FOREST_REAL_DEVICE_PILOT=pending
DR_FOREST_MULTI_CLIENT_PILOT=pending
DR_FOREST_MONITORING_VERIFIED=pending
DR_FOREST_AI_PROVIDER_VERIFIED=pending
DR_FOREST_MEDIA_SCAN_VERIFIED=pending
